{% assign s = site.data.socials %}
<ul class="social-links">
  {% if s.email %}
    <li>
      <a href="mailto:{{ s.email | encode_email }}" aria-label="Email" title="Email"><i class="fa-solid fa-envelope" aria-hidden="true"></i></a>
    </li>
  {% endif %}
  {% if s.github_username %}
    <li>
      <a href="https://github.com/{{ s.github_username }}" aria-label="GitHub" title="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i></a>
    </li>
  {% endif %}
  {% if s.linkedin_username %}
    <li>
      <a href="https://www.linkedin.com/in/{{ s.linkedin_username }}" aria-label="LinkedIn" title="LinkedIn"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>
    </li>
  {% endif %}
  {% if s.scholar_userid %}
    <li>
      <a href="https://scholar.google.com/citations?user={{ s.scholar_userid }}" aria-label="Google Scholar" title="Google Scholar"><i class="ai ai-google-scholar" aria-hidden="true"></i></a>
    </li>
  {% endif %}
  {% if s.orcid_id %}
    <li>
      <a href="https://orcid.org/{{ s.orcid_id }}" aria-label="ORCID" title="ORCID"><i class="ai ai-orcid" aria-hidden="true"></i></a>
    </li>
  {% endif %}
</ul>
