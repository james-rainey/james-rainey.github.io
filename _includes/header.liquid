<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container">
    <a class="site-brand" href="{{ '/' | relative_url }}">
      <span class="brand-mark" aria-hidden="true">{{ site.first_name | slice: 0 }}{{ site.last_name | slice: 0 }}</span>
      {{ site.first_name }} {{ site.last_name }}
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {% assign nav_pages = site.pages | where: 'nav', true | sort: 'nav_order' %}
        {% for p in nav_pages %}
          {% assign is_current = false %}
          {% if page.url == p.url or page.collection == 'projects' and p.permalink == '/projects/' %}
            {% assign is_current = true %}
          {% endif %}
          <li>
            <a href="{{ p.url | relative_url }}" {% if is_current %}aria-current="page"{% endif %}>{{ p.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <button class="icon-button theme-toggle" type="button" id="theme-toggle" aria-label="Toggle dark mode">
      <i class="fa-solid fa-moon" aria-hidden="true"></i>
      <i class="fa-solid fa-sun" aria-hidden="true"></i>
    </button>
    <button class="icon-button nav-toggle" type="button" id="nav-toggle" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
  </div>
</header>
