<a class="card" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" data-category="{{ project.category }}">
  <div class="card-media{% if project.img_fit == 'contain' %} card-media--contain{% endif %}">
    {% if project.img %}
      {% include figure.liquid path=project.img sizes="(min-width: 1080px) 340px, (min-width: 640px) 45vw, 95vw" alt="" %}
    {% else %}
      <div class="card-placeholder"><i class="{{ project.icon | default: 'fa-solid fa-flask' }}" aria-hidden="true"></i></div>
    {% endif %}
  </div>
  <div class="card-body">
    <h3>{{ project.title }}</h3>
    <p>{{ project.tagline | default: project.description }}</p>
    {% if include.featured %}
      {% if project.my_role and project.my_role != '' %}<p><strong>My role:</strong> {{ project.my_role | escape }}</p>{% endif %}
      {% if project.featured_result %}<p class="featured-result">{{ project.featured_result | escape }}</p>{% endif %}
    {% endif %}
    {% if project.tags %}
      <ul class="chip-list">
        {% for tag in project.tags limit: 3 %}<li class="chip">{{ tag }}</li>{% endfor %}
      </ul>
    {% endif %}
  </div>
</a>
