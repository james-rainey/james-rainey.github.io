<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0f766e">

<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Apply the saved theme before first paint to avoid a flash -->
<script>
  (function () {
    try {
      var t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  })();
</script>

<!-- Fonts & Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ site.third_party_libraries.google_fonts.url.fonts }}">
<link rel="stylesheet" href="{{ '/assets/css/academicons.min.css' | relative_url | bust_file_cache }}">

{% if site.icon.size <= 4 %}
  <link
    rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache }}">
{% endif %}

<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.first_name }} {{ site.last_name }}" href="{{ '/feed.xml' | relative_url }}">

{% if site.enable_math and page.math %}
  <script defer src="{{ site.third_party_libraries.mathjax.url.js }}" integrity="{{ site.third_party_libraries.mathjax.integrity.js }}" crossorigin="anonymous"></script>
{% endif %}
