---
layout: default
---
<section class="hero">
  <div class="hero-text">
    {% if page.eyebrow %}<p class="eyebrow">{{ page.eyebrow }}</p>{% endif %}
    <h1>{{ site.first_name }} {{ site.last_name }}</h1>
    {% if page.subtitle %}<p class="hero-role">{{ page.subtitle }}</p>{% endif %}
    {% if page.pitch %}<p class="hero-pitch">{{ page.pitch }}</p>{% endif %}
    <div class="hero-actions">
      <a class="btn btn-primary" href="{{ '/projects/' | relative_url }}">View projects <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      <a class="btn btn-ghost" href="{{ '/cv/' | relative_url }}">CV</a>
      {% include social.liquid %}
    </div>
  </div>
  {% if page.profile.image %}
    <div class="hero-photo">
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {% include figure.liquid loading="eager" path=profile_image_path sizes="260px" alt="Photo of James Rainey" cache_bust=true %}
    </div>
  {% endif %}
</section>

{% if page.featured_projects %}
  <section class="section" aria-labelledby="featured-projects-heading">
    <div class="section-header">
      <h2 id="featured-projects-heading">Featured projects</h2>
      <a href="{{ '/projects/' | relative_url }}">All projects &rarr;</a>
    </div>
    <div class="card-grid featured-grid">
      {% for slug in page.featured_projects %}
        {% assign project = site.projects | where: "slug", slug | first %}
        {% if project %}{% include projects.liquid featured=true %}{% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

<section class="section">
  <div class="section-header"><h2>About</h2></div>
  <div class="prose prose--full">{{ content }}</div>
</section>

{% if page.research_areas %}
  <section class="section">
    <div class="section-header">
      <h2>Research areas</h2>
      <a href="{{ '/projects/' | relative_url }}">All projects &rarr;</a>
    </div>
    <div class="area-grid">
      {% for area in page.research_areas %}
        {% if area.url %}<a class="area" href="{{ area.url | relative_url }}">{% else %}<div class="area">{% endif %}
          <span class="area-icon"><i class="{{ area.icon }}" aria-hidden="true"></i></span>
          <h3>{{ area.title }}</h3>
          <p>{{ area.text }}</p>
        {% if area.url %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% if page.announcements.enabled and site.news.size > 0 %}
  <section class="section">
    <div class="section-header"><h2>News</h2></div>
    {% include news.liquid limit=page.announcements.limit %}
  </section>
{% endif %}

{% if page.selected_papers %}
  <section class="section">
    <div class="section-header">
      <h2>Selected publications</h2>
      <a href="{{ '/publications/' | relative_url }}">All publications &rarr;</a>
    </div>
    {% include selected_papers.liquid %}
  </section>
{% endif %}
