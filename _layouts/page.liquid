---
layout: default
---
<header class="page-header">
  {% if page.eyebrow %}<p class="eyebrow">{{ page.eyebrow }}</p>{% endif %}
  <h1>{{ page.heading | default: page.title }}</h1>
  {% if page.lead %}<p class="page-lead">{{ page.lead }}</p>{% endif %}
</header>

<article class="{% unless page.wide %}prose{% endunless %}">
  {{ content }}
</article>

{% if page.related_publications %}
  <section class="references">
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  </section>
{% endif %}
